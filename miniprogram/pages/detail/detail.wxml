<view class="wrap"><view wx:if="{{item}}"><text class="tag">{{item.categoryLabel}}</text><view class="hero" style="font-size:44rpx">{{item.title}}</view><view class="muted">{{item.source}} · {{item.date}}</view><view class="card"><view class="eyebrow">情报摘要</view><view class="summary" style="margin-top:24rpx" user-select>{{item.summary}}</view></view><view class="muted">综合价值 {{item.score}} / 10 · 证据 {{item.evidence}} / 10 · 优先级 {{item.priority}} 星</view><button bindtap="save">{{saved?'取消收藏':'收藏这条情报'}}</button><button bindtap="copy">复制原文链接</button><view class="muted" style="margin-top:20rpx">复制后可在浏览器阅读原文</view><view wx:for="{{item.references}}" wx:key="url" class="card" data-url="{{item.url}}" bindtap="copy"><view class="muted">同事件参考来源 · 点击复制链接</view><view class="link">{{item.title}}</view></view></view><view wx:if="{{missing}}" class="empty">该情报已更新或暂不可用，请返回首页刷新</view></view>
