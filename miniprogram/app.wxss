page{background:#f4f6f2;color:#182c28;font-family:sans-serif}.wrap{padding:36rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#50796a}.hero{font-size:58rpx;font-weight:700;line-height:1.3;margin:22rpx 0}.muted{color:#77877e;font-size:24rpx;line-height:1.7}.card{background:#fff;border-radius:24rpx;padding:32rpx;margin:24rpx 0;border:1rpx solid #e2e8df}.title{font-size:34rpx;font-weight:600;line-height:1.55;margin:18rpx 0}.summary{font-size:28rpx;color:#52645b;line-height:1.9;white-space:pre-wrap}.tag{font-size:23rpx;color:#26755c;background:#eaf4ec;padding:8rpx 14rpx;border-radius:8rpx;margin-right:12rpx}.row{display:flex;justify-content:space-between;align-items:center}.tabs{display:flex;gap:12rpx;margin:28rpx 0;flex-wrap:wrap}.tab{padding:16rpx 22rpx;background:#e7ece4;border-radius:40rpx;font-size:25rpx}.active{background:#183f33;color:white}input{background:white;padding:25rpx;border-radius:16rpx;font-size:28rpx}.empty{text-align:center;padding:90rpx 20rpx;color:#77877e}button{font-size:28rpx;margin-top:26rpx;background:#183f33;color:white;border-radius:16rpx}.link{color:#28795b;font-size:26rpx;word-break:break-all}
